---
import Layout from '../layouts/Layout.astro';

const topics = [
	{ number: '01', title: 'Technology & Architecture', note: 'Systems, software, and how things fit together' },
	{ number: '02', title: 'AI & Machine Learning', note: 'New tools, ideas, and their possibilities' },
	{ number: '03', title: 'Culture & Humanities', note: 'History, philosophy, and the human story' },
	{ number: '04', title: 'Personal Experiments', note: 'Small questions, practical explorations' },
	{ number: '05', title: 'Projects & Builds', note: 'Things imagined, made, and learned from' },
];

const year = new Date().getFullYear();
---

<Layout
	title="Sachin Gaikwad — A Space for Ideas & Exploration"
	description="A personal space for ideas, experiments, and learning across technology, culture, and the things I'm building. Coming soon from Sachin Gaikwad in Pune, India."
>
	<div class="site-shell">
		<header class="site-header">
			<p class="wordmark">Sachin <span>Gaikwad</span></p>
			<p class="header-note"><span class="header-mark" aria-hidden="true"></span> A PERSONAL WEBSITE</p>
		</header>

		<main>
			<section class="hero" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow"><span>01</span> A PERSONAL SPACE FOR IDEAS &amp; EXPLORATION</p>
					<h1 id="hero-title">Curiosity leads.<br /><span>Building follows.</span></h1>
					<p class="intro">
						A space for ideas, experiments, things I'm learning, and things I'm building.
						Exploring technology, understanding the world, and connecting the dots along the way.
					</p>

					<div class="status">
						<span class="status-dot" aria-hidden="true"></span>
						<div>
							<p class="status-title">Currently under construction</p>
							<p class="status-copy">Something thoughtful is taking shape. Come back soon.</p>
						</div>
					</div>
				</div>

				<div class="hero-art" aria-hidden="true">
					<div class="art-caption art-caption-top">A WORKING NOTEBOOK</div>
					<svg class="orbit-art" viewBox="0 0 480 480" fill="none" xmlns="http://www.w3.org/2000/svg">
						<circle cx="240" cy="240" r="205" stroke="currentColor" stroke-opacity=".18" />
						<circle cx="240" cy="240" r="164" stroke="currentColor" stroke-opacity=".28" />
						<circle cx="240" cy="240" r="112" stroke="currentColor" stroke-opacity=".38" />
						<path d="M240 35C306 90 350 158 350 240S306 390 240 445C174 390 130 322 130 240S174 90 240 35Z" stroke="currentColor" stroke-opacity=".28" />
						<path d="M35 240H445M240 35V445" stroke="currentColor" stroke-opacity=".18" />
						<circle cx="240" cy="240" r="67" fill="#E9E5D8" />
						<path d="M217 258C226 237 242 219 265 207M229 246C223 231 225 218 231 207M240 234C251 236 261 242 267 252M231 250C242 252 249 259 252 269" stroke="#345342" stroke-width="1.5" stroke-linecap="round" />
						<circle cx="240" cy="240" r="3" fill="#345342" />
						<circle cx="353" cy="116" r="5" fill="#8A9B79" />
						<circle cx="113" cy="325" r="4" fill="#B5A68D" />
						<path d="M351 116L390 82" stroke="#345342" stroke-opacity=".45" />
					</svg>
					<div class="art-caption art-caption-bottom"><span>OBSERVE</span><span>CONNECT</span><span>MAKE</span></div>
					<span class="art-index">NOTES / 001</span>
				</div>
			</section>

			<section class="topics" aria-labelledby="topics-title">
				<div class="section-heading">
					<div>
						<p class="eyebrow"><span>02</span> WHAT'S ON MY MIND</p>
						<h2 id="topics-title">A few things I'll keep exploring</h2>
					</div>
					<p class="section-note">UPCOMING AREAS <span aria-hidden="true">↘</span></p>
				</div>

				<ul class="topic-list">
					{topics.map((topic) => (
						<li class="topic">
							<span class="topic-number">{topic.number}</span>
							<div class="topic-content">
								<h3>{topic.title}</h3>
								<p>{topic.note}</p>
							</div>
							<span class="topic-mark" aria-hidden="true">↗</span>
						</li>
					))}
				</ul>
			</section>
		</main>

		<footer class="site-footer">
			<p>Made with curiosity in <span>Pune, India.</span></p>
			<p class="copyright">© {year} Sachin Gaikwad</p>
		</footer>
	</div>
</Layout>

<style>
	.site-shell {
		width: min(100% - 96px, 1200px);
		min-height: 100vh;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
	}

	.site-header {
		min-height: 88px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--line);
	}

	.wordmark {
		margin: 0;
		color: var(--forest);
		font-family: var(--serif);
		font-size: 1.17rem;
		letter-spacing: -0.035em;
	}

	.wordmark span {
		font-style: italic;
		font-weight: 400;
	}

	.header-note,
	.eyebrow,
	.section-note,
	.art-caption,
	.art-index {
		font-size: 0.63rem;
		font-weight: 600;
		letter-spacing: 0.13em;
	}

	.header-note {
		display: flex;
		align-items: center;
		gap: 10px;
		color: var(--muted);
	}

	.header-mark {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--sage);
	}

	main {
		flex: 1;
	}

	.hero {
		min-height: 565px;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		align-items: center;
		gap: 40px;
		padding-block: 66px 72px;
		border-bottom: 1px solid var(--line);
	}

	.hero-copy {
		position: relative;
		z-index: 1;
		padding-block: 10px;
	}

	.eyebrow {
		display: flex;
		align-items: center;
		gap: 13px;
		margin: 0 0 26px;
		color: var(--muted);
	}

	.eyebrow span {
		color: var(--sage);
		font-family: var(--serif);
		font-size: 0.85rem;
		font-style: italic;
		letter-spacing: 0;
	}

	h1,
	h2,
	h3,
	p {
		margin-top: 0;
	}

	h1 {
		margin-bottom: 23px;
		color: var(--forest);
		font-family: var(--serif);
		font-size: clamp(3.2rem, 6.15vw, 5.55rem);
		font-weight: 400;
		letter-spacing: -0.065em;
		line-height: 0.99;
	}

	h1 span {
		color: var(--sage);
		font-style: italic;
	}

	.intro {
		max-width: 470px;
		margin-bottom: 34px;
		color: var(--body);
		font-size: 0.97rem;
		line-height: 1.85;
	}

	.status {
		display: flex;
		align-items: flex-start;
		gap: 13px;
		padding-top: 19px;
		border-top: 1px solid var(--line);
	}

	.status-dot {
		position: relative;
		flex: 0 0 auto;
		width: 8px;
		height: 8px;
		margin-top: 5px;
		border-radius: 50%;
		background: var(--forest);
		box-shadow: 0 0 0 4px #e8ebdf;
	}

	.status-title {
		margin-bottom: 5px;
		color: var(--forest);
		font-size: 0.83rem;
		font-weight: 600;
	}

	.status-copy {
		margin-bottom: 0;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.6;
	}

	.hero-art {
		position: relative;
		display: grid;
		place-items: center;
		width: min(100%, 430px);
		aspect-ratio: 1;
		justify-self: end;
		color: var(--forest);
	}

	.hero-art::before {
		position: absolute;
		width: 70%;
		height: 70%;
		border-radius: 50%;
		background: #eeece2;
		content: '';
	}

	.orbit-art {
		position: relative;
		width: 100%;
		overflow: visible;
	}

	.art-caption,
	.art-index {
		position: absolute;
		z-index: 1;
		color: var(--muted);
		font-size: 0.55rem;
	}

	.art-caption-top {
		top: 12%;
		left: 3%;
	}

	.art-caption-bottom {
		right: 2%;
		bottom: 13%;
		left: 2%;
		display: flex;
		justify-content: space-between;
		padding-top: 10px;
		border-top: 1px solid var(--line);
	}

	.art-index {
		right: 1%;
		top: 28%;
		writing-mode: vertical-rl;
	}

	.topics {
		padding-block: 48px 45px;
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 25px;
	}

	.section-heading .eyebrow {
		margin-bottom: 12px;
	}

	h2 {
		margin-bottom: 0;
		color: var(--forest);
		font-family: var(--serif);
		font-size: clamp(1.7rem, 3vw, 2.45rem);
		font-weight: 400;
		letter-spacing: -0.04em;
	}

	.section-note {
		flex: 0 0 auto;
		margin-bottom: 6px;
		color: var(--muted);
		font-size: 0.58rem;
	}

	.section-note span {
		margin-left: 8px;
		color: var(--sage);
		font-size: 0.85rem;
	}

	.topic-list {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
		border: 1px solid var(--line);
	}

	.topic {
		position: relative;
		min-height: 145px;
		padding: 17px 16px 15px;
		border-right: 1px solid var(--line);
	}

	.topic:last-child {
		border-right: 0;
	}

	.topic-number {
		display: block;
		margin-bottom: 20px;
		color: var(--sage);
		font-family: var(--serif);
		font-size: 0.85rem;
		font-style: italic;
	}

	.topic h3 {
		margin-bottom: 7px;
		color: var(--forest);
		font-family: var(--serif);
		font-size: 1.05rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.25;
	}

	.topic p {
		margin-bottom: 0;
		color: var(--muted);
		font-size: 0.68rem;
		line-height: 1.55;
	}

	.topic-mark {
		position: absolute;
		top: 15px;
		right: 14px;
		color: #a7ad9c;
		font-size: 0.75rem;
	}

	.site-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 20px;
		min-height: 68px;
		border-top: 1px solid var(--line);
		color: var(--muted);
		font-size: 0.73rem;
	}

	.site-footer p {
		margin-bottom: 0;
	}

	.site-footer > p:first-child span {
		color: var(--forest);
	}

	.copyright {
		font-size: 0.68rem;
	}

	@media (min-width: 1440px) {
		.hero {
			min-height: 600px;
		}
	}

	@media (max-width: 760px) {
		.site-shell {
			width: min(100% - 48px, 600px);
		}

		.site-header {
			min-height: 72px;
		}

		.hero {
			min-height: auto;
			grid-template-columns: 1fr;
			gap: 12px;
			padding-block: 61px 42px;
		}

		.hero-copy {
			padding: 0;
		}

		.hero-art {
			width: min(78%, 330px);
			justify-self: center;
			margin-block: 2px 6px;
		}

		.topics {
			padding-block: 38px;
		}

		.topic-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.topic {
			min-height: 135px;
			border-bottom: 1px solid var(--line);
		}

		.topic:nth-child(2n) {
			border-right: 0;
		}

		.topic:nth-last-child(-n + 1) {
			border-bottom: 0;
		}
	}

	@media (max-width: 480px) {
		.site-shell {
			width: min(100% - 36px, 400px);
		}

		.header-note {
			gap: 7px;
			font-size: 0.53rem;
			letter-spacing: 0.1em;
		}

		.eyebrow {
			gap: 9px;
			font-size: 0.56rem;
			letter-spacing: 0.1em;
		}

		h1 {
			font-size: clamp(3.15rem, 13vw, 4.1rem);
		}

		.intro {
			font-size: 0.9rem;
		}

		.section-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 10px;
		}

		.section-note {
			margin-left: 32px;
		}

		.topic {
			padding-inline: 12px;
		}

		.topic h3 {
			max-width: 140px;
			font-size: 0.97rem;
		}

		.topic p {
			font-size: 0.64rem;
		}

		.site-footer {
			align-items: flex-start;
			flex-direction: column;
			justify-content: center;
			gap: 6px;
			padding-block: 16px;
		}
	}
</style>
